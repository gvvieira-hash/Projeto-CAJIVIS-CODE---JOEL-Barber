# Conexão com o banco (Railway ou Local)
DATABASE_URL="mysql://usuario:senha@host-da-railway.railway.app:3306/nome_do_banco"

# Porta da API
PORT=3000

# Configurações de E-mail (Brevo)
BREVO_API_KEY="sua_chave_brevo_aqui"
BREVO_SENDER_EMAIL="seu_email_brevo_aqui"
EMAIL_CODE_SECRET="seu_segredo_aqui"
